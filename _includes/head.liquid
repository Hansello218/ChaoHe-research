<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>
  {% if page.permalink == '/' %}Chao He | Academic Homepage{% else %}{{ page.title }} | {{ site.title }}{% endif %}
</title>
<meta name="author" content="{{ site.first_name }} {{ site.last_name }}">
<meta name="description" content="{{ site.description | strip | escape }}">
<link rel="canonical" href="{{ page.url | replace: 'index.html', '' | absolute_url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{% if page.permalink == '/' %}Chao He | Academic Homepage{% else %}{{ page.title }} | {{ site.title }}{% endif %}">
<meta property="og:description" content="{{ site.description | strip | escape }}">
<meta property="og:url" content="{{ page.url | replace: 'index.html', '' | absolute_url }}">
<link rel="icon" href="{{ '/assets/img/favicon.svg' | relative_url }}" type="image/svg+xml">
<style>
  :root { --max-content-width: {{ site.max_width }}; }
</style>
<link rel="stylesheet" href="{{ '/assets/css/tailwind.css' | relative_url }}">
<link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url }}">
<link rel="stylesheet" href="{{ '/assets/css/academic.css' | relative_url }}">
